    <ClInclude Include="..\src\client\tcp_client.h" />
    <ClInclude Include="..\src\client\socket_set.h" />
  </ItemGroup>
  <!-- ProjectReference 없음 — common.vcxproj 를 참조하지 않는다(위 주석 참조). -->
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
