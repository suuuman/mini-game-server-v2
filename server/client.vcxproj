<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="ASan|x64">
      <Configuration>ASan</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>18.0</VCProjectVersion>
    <ProjectGuid>{6A53A478-6F49-4B08-BE8D-BFD0540BD322}</ProjectGuid>
    <RootNamespace>client</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Condition="'$(Configuration)'=='Debug'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='ASan'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
  </PropertyGroup>
  <Import Project="common.props" />
  <PropertyGroup>
    <TargetName>client</TargetName>
  </PropertyGroup>
  <!-- LinkIncremental 은 item metadata 가 아니라 PropertyGroup 속성이다.
       ASan 은 증분 링크와 같이 못 쓴다 (LNK4300) — session.vcxproj:39-41 과 동형. -->
  <PropertyGroup Condition="'$(Configuration)'=='ASan'">
    <LinkIncremental>false</LinkIncremental>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <!-- FD_SETSIZE 를 1024 로 올린다 — 기본값은 winsock2.h 의 64 다. MS Learn "Maximum Number of Sockets Supported" — "the implementor should define the manifest FD_SETSIZE in every source file before including the Winsock2.h header file"(2026-09-06 열람).
         이 /D 정의가 실제로 각 소스의 winsock2.h include 보다 먼저
         닿는지는 socket_set.h 의 static_assert(FD_SETSIZE >= 1024, ...)
         가 컴파일 타임에 증명한다 — 안 닿으면 기본값 64 에서 그 자리가
         바로 실패한다. 1024 인 근거 — 후보 B(L1 경합 고부하 실측 ·
         ADR-028 미검증 ③)가 이 클라로 수백 접속을 돌릴 예정이라 미리
         올려 둔다. 정확한 상한은 잰 적이 없다(T016-plan.md 결정 2).
         common.props(서버 exe 공용)가 아니라 여기 두는 이유 —
         common.lib·village.exe·session.exe 는 IOCP 라 select 를 안
         쓴다, FD_SETSIZE 가 그 셋에는 아무 의미가 없다. -->
    <ClCompile>
      <PreprocessorDefinitions>FD_SETSIZE=1024;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <!-- common.lib 를 ProjectReference 로 물지 않는 이유 — proto/packet.h 는
           <cstdint>·<cstddef> 만 include 하는 헤더 전용이다(packet.h:8-9).
           헤더 include 만으로 encode_header/decode_header/MsgId 를 그대로 쓸 수
           있어 코덱 사본이 필요 없고, 그래서 링크도 필요 없다(ADR-029 결정 2).
           이 exe 는 client → proto 하나만 의존한다 — common.lib 에 있는
           net/db/app/core 오브젝트를 하나도 끌어오지 않는다. -->
      <!-- ws2_32 만 링크하는 이유 — 이 클라는 소켓 API(winsock2)만 쓴다.
           session.exe 가 링크하는 winmm·dbghelp 는 각각 core::log.h 의 시간
           원본과 ops::crash_dump 의 덤프 생성이 쓰는데, 이 클라는 core/ 를
           include 하지 않으므로(계층 금지 — ADR-029 결정 2) 그 둘을 안 쓴다.
           링크 에러가 나면 그때 추가한다(session.vcxproj:45-47 관례 그대로). -->
      <AdditionalDependencies>ws2_32.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <Link>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="..\src\client\main.cpp" />
    <ClCompile Include="..\src\client\tcp_client.cpp" />
    <ClCompile Include="..\src\client\cmd_send.cpp" />
    <ClCompile Include="..\src\client\cmd_flow.cpp" />
    <ClCompile Include="..\src\client\selftest.cpp" />
    <ClCompile Include="..\src\client\cmd_zone.cpp" />
    <ClCompile Include="..\src\client\cmd_churn.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="..\src\client\commands.h" />
